  itemID: diary_3
  itemSprite: {fileID: 21300000, guid: f68f7c5d6db1d8f44927a0e6e8e2b19b, type: 3}
  itemDescription: "Diario del Viaggiatore\n\n\nC'\xE8 una strana usanza in questo
    paese. Varia da regione a regione, ma la radice \xE8 la stessa. \xC8 misteriosa,
    eppure in qualche modo bella.\r\n\r\nPer capirla, ho deciso di stabilirmi su
    questa montagna.\r\n\r\nLa bellezza della rugiada mattutina, la palpabile angoscia
    del sole che tramonta dietro la montagna, la notte grave e solenne che la avvolge."
  useObjectSound: 0
  objectSound: {fileID: 0}
  soundVolume: 1
