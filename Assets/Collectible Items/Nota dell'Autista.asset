  m_Script: {fileID: 11500000, guid: c417e88f4e3ad854cae814ec58f10992, type: 3}
  m_Name: Nota dell'Autista
  m_EditorClassIdentifier: 
  itemID: note_3
  itemSprite: {fileID: 21300000, guid: cd8d82d28ab5d914b92c5f25e031f821, type: 3}
  itemDescription: "Nota dell'Autista\n\n\nMi dispiace per l'accaduto... \xE8...
    \xE8 tutta colpa mia... ho perso il controllo del mezzo ed ora siamo in questa
    situazione...\n\nSono andato a cercare aiuto, se dovesse servirvi qualcosa c'\xE8
    una <color=red>cassetta</color> con materiale di primo soccorso nel retro dell'Autobus.\n\nPrendete
    pure ci\xF2 che vi serve."
