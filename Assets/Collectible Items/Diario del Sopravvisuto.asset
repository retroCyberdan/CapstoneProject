  m_Script: {fileID: 11500000, guid: c417e88f4e3ad854cae814ec58f10992, type: 3}
  m_Name: Diario del Sopravvisuto
  m_EditorClassIdentifier: 
  itemID: diary_1
  itemSprite: {fileID: 21300000, guid: 2ea31d815460e9c45b77a0913747f695, type: 3}
  itemDescription: "Diario del Sopravvisuto\n\n\nHo visto la silhouette di una strana
    donna nella nebbia che avvolge il villaggio.\r\n\r\nA piccoli passi, quasi trascinandosi,
    si faceva strada lentamente su per la via principale.\r\n\r\nQualcosa in lei
    sembrava in qualche modo... innaturale.\r\n\r\nMi \xE8 stato detto che non ci
    sono pi\xF9 persone e che il villaggio \xE8 abbandonato ora.\r\n\r\nMolto tempo
    fa, molte donne furono assassinate qui. Forse sono tornate dall'aldil\xE0?\r\n\r\nQuesto
    implicherebbe che siano intrappolate ui come me?"
