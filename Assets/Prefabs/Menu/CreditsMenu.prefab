  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "MASU Productions\n\n\n\nVISION OF D\n\n\n\nMAIN DIRECTOR, GAME DESIGNER
    e PROGRAMMING\nDaniele Feola\n\n\nWORLD MAP DESIGN\nDaniele Feola\n\n\nATTRIBUZIONI
    SPECIALI PER ASSETS GRAFICI\nBrieucSwales\nlocal.yany\nSeven.Four\nSousinho\nYadroGames\nMrUnity\nFuji\nRenafox\nRusty-exe\nLiliumLetifer\nWhiskey\nTokuwa\nNice2meetU2\nendlessvoidmc\nsergeykuchmin\namanpatel9725\nkinito\nDawnstar-Chronicles\nVeterock\nVasian-Digital3D\nudi_kreasindo3D\nschmoldt.art\nKing
    Potato\no0ozexo0o\naribb\nImran Aziz\n\n\n\nSea Rover Sanguine\nClawbriar\ndaemoth\n\n\n\nATTRIBUZIONI
    SPECIALI PER ASSETS AUDIO\nMysticus\n\n\n\ntutte le opere grafiche, comprensive
    di modelli tridimensionali di personaggi, oggetti, strutture ed edifici, modelli
    3D vari sono dei rispettivi proprietari.\n\ntutti gli asset grafici utilizzati
    sono sotto licenza CC Attribution.\n\ntutti gli assets audio sono dei rispettivi
    proprietari.\n\n\n\nALTRE ATTRIBUZIONI\nTheSpritersResources\nTheSoundsResources\nthelostvillage
    (Fatal Frame wiki)\n\n\n\nQuest`opera \xE8 liberamente ispirata ad altre opere
    maggiori e saghe videoludiche di successo quali Silent Hill, Fatal Frame, Haunting
    Ground e Resident Evil. Ogni riferimento a persone, luoghi, eventi realmente
    accaduti \xE8 puramente casuale o a scopo meramente esercitativo.\n\nQuest`opera
    \xE8 frutto dell`amore e della passione che lo sviluppatore nutre in questo genere
    videoludico e nella stima e ammirazione verso quelle persone che hanno creato
    e dettato le regole del genere.\n\n\n\nRingraziamenti speciali a EPICODE School
    per avermi dato modo di apprendere le nozioni fondamentali per poter creare un
    progetto del genere.\n\n\n\n\nGrazie mille a Jacopo Zuliani e Luca Villanini
    per la loro professionalit\xE0, passione e amicizia.\n\n\n\n\n\n2025 - Tutti
    i diritti riservati."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 52bcdc70e6fa1244489afe9317251bd9, type: 2}
